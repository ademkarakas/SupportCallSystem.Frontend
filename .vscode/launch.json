{
  //https://blogs.windows.com/msedgedev/2021/07/16/easier-debugging-developer-tools-in-visual-studio-code/
  //https://github.com/microsoft/vscode-js-debug#readme

  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Edge",
      "request": "launch",
      "type": "msedge",
      // "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}"
      // "sourceMaps": true,
      // "resolveSourceMapLocations": [
      //   "${workspaceFolder}/**",
      //   "!**/node_modules/**"
      // ]
    },
    {
      "name": "Launch Chrome",
      "request": "launch",
      "type": "chrome",
      // "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}"
      // "sourceMaps": true,
      // "resolveSourceMapLocations": [
      //   "${workspaceFolder}/**",
      //   "!**/node_modules/**"
      // ]
    },
    {
      "name": "Launch Microsoft Edge",
      "type": "msedge",
      "request": "launch",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "url": "http://localhost:4200/",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Launch Microsoft Edge in headless mode",
      "type": "msedge",
      "request": "launch",
      "runtimeArgs": ["--headless", "--remote-debugging-port=9222"],
      "url": "http://localhost:4200/",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Open Edge DevTools",
      "type": "vscode-edge-devtools.debug",
      "request": "attach",
      "url": "http://localhost:4200/",
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Launch Edge and attach DevTools",
      "configurations": ["Launch Microsoft Edge", "Open Edge DevTools"]
    },
    {
      "name": "Launch Edge Headless and attach DevTools",
      "configurations": ["Launch Microsoft Edge in headless mode", "Open Edge DevTools"]
    }
  ]
}
